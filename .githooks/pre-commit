#!/bin/bash

# CAWS Pre-commit Hook - Quality Gates with Waiver Support
# @author @darianrosebrook
# Uses .mjs todo-analyzer through quality gates runner (waiver-aware)
# Replaces Python analyzer which doesn't check waivers

echo "🚦 Running CAWS Quality Gates (Pre-commit Mode)..."

# Get staged files that are being committed
STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
    echo "ℹ️  No files staged for commit"
    exit 0
fi

# Run CAWS quality gates with waiver recognition
# This uses the .mjs todo-analyzer which respects CAWS waivers
if [ -f "scripts/quality-gates/run-quality-gates.mjs" ]; then
    # Check if Node.js is available
    if command -v node &> /dev/null; then
        # Check if dependencies are installed
        if [ ! -d "node_modules" ] || [ ! -f "node_modules/js-yaml/package.json" ]; then
            echo "⚠️  Quality gates dependencies not installed"
            echo "💡 Run 'npm install' to enable quality checking"
            echo "💡 Proceeding with commit (dependencies missing)"
            exit 0
        fi
        
        # Run quality gates in commit context (blocks on unwaived violations)
        # The quality gates runner uses .mjs todo-analyzer which checks waivers
        if node scripts/quality-gates/run-quality-gates.mjs --context commit 2>&1; then
            echo "✅ Quality gates passed"
            exit 0
        else
            EXIT_CODE=$?
            # Check if it's a dependency error vs actual violations
            if [ $EXIT_CODE -eq 1 ]; then
                echo ""
                echo "❌ Quality gate violations detected - commit blocked"
                echo "💡 Fix the violations above before committing"
                echo "💡 Waived violations are allowed (check .caws/waivers/active-waivers.yaml)"
                echo "💡 You can bypass this check with: git commit --no-verify"
            else
                echo ""
                echo "⚠️  Quality gates script error (exit code: $EXIT_CODE)"
                echo "💡 This may be a dependency issue - run 'npm install'"
                echo "💡 Proceeding with commit (script error)"
            fi
            exit $EXIT_CODE
        fi
    else
        echo "⚠️  Node.js not found - skipping quality gates check"
        echo "💡 Install Node.js to enable automatic quality checking"
        exit 0
    fi
else
    echo "⚠️  Quality gates script not found - skipping check"
    exit 0
fi
