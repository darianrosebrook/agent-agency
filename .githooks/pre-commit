#!/bin/bash

# CAWS Pre-commit Hook - Hidden TODO Analyzer + Quality Gates (Waiver-Aware)
# @author @darianrosebrook

echo "🔍 CAWS Pre-commit Hook: Running quality checks..."

# Get staged files that are being committed
STAGED_FILES=$(git diff --cached --name-only | tr '\n' ' ')

if [ -z "$STAGED_FILES" ]; then
    echo "ℹ️  No files staged for commit"
    exit 0
fi

echo "📁 Files to check: $STAGED_FILES"

# Check if Python is available
if ! command -v python3 &> /dev/null; then
    echo "⚠️  Python3 not found - skipping hidden TODO check"
else
    # Check if the analyzer script exists
    if [ -f "iterations/v3/scripts/todo_analyzer.py" ]; then
        # Run the analyzer in warn-only mode
        echo "🔍 Running hidden TODO analysis..."
        cd iterations/v3
        python3 scripts/todo_analyzer.py --files $STAGED_FILES --warn-only --verbose
        cd ../..
    else
        echo "⚠️  TODO analyzer script not found - skipping check"
    fi
fi

# Run CAWS quality gates with waiver recognition (warn-only mode for pre-commit)
if [ -f "scripts/quality-gates/run-quality-gates.mjs" ]; then
    echo "🔍 Running CAWS quality gates (waiver-aware)..."
    
    # Check if Node.js is available
    if command -v node &> /dev/null; then
        # Run quality gates in commit context (warns but doesn't block)
        node scripts/quality-gates/run-quality-gates.mjs --context commit --quiet || {
            echo ""
            echo "⚠️  QUALITY GATE VIOLATIONS DETECTED"
            echo "   The commit will proceed, but please review the violations above"
            echo "   Waived violations are allowed and logged for audit"
            echo "   You can bypass this check with: git commit --no-verify"
        }
    else
        echo "⚠️  Node.js not found - skipping quality gates check"
    fi
else
    echo "⚠️  Quality gates script not found - skipping check"
fi

echo "✅ Pre-commit checks completed"
exit 0
