# Development Environment Variables
# Copy this file to .env.local and configure for your development environment

# Mock Data Configuration
# Set to 'true' to use mock data instead of real API calls during development
NEXT_PUBLIC_USE_MOCK_DATA=true

# API Configuration
# Base URL for the Agent Agency V3 backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# WebSocket Configuration
# WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Development Settings
# Enable debug logging
NEXT_PUBLIC_DEBUG=true

# Enable performance monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING=true

# Mock Data Settings
# Simulate network delays (milliseconds)
NEXT_PUBLIC_MOCK_DELAY=100

# Simulate occasional errors (percentage, 0-100)
NEXT_PUBLIC_MOCK_ERROR_RATE=5

# Dashboard Configuration
# Enable real-time updates
NEXT_PUBLIC_REALTIME_UPDATES=true

# Update intervals (milliseconds)
NEXT_PUBLIC_UPDATE_INTERVAL=30000

# Apple Silicon Configuration
# Enable Apple Silicon monitoring
NEXT_PUBLIC_APPLE_SILICON_MONITORING=true

# Thermal monitoring settings
NEXT_PUBLIC_THERMAL_MONITORING=true

# Council Configuration
# Enable council oversight features
NEXT_PUBLIC_COUNCIL_OVERSIGHT=true

# Security Configuration
# Enable security monitoring
NEXT_PUBLIC_SECURITY_MONITORING=true

# Observability Configuration
# Enable system observability
NEXT_PUBLIC_OBSERVABILITY=true

# Workspace Configuration
# Enable workspace management
NEXT_PUBLIC_WORKSPACE_MANAGEMENT=true