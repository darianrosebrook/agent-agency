{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-agency.com/schemas/judge-verdict-engine.json",
  "title": "Judge Verdict Engine Schema",
  "description": "Schema for structured judge verdicts from inference engines",
  "type": "object",
  "required": ["score", "label", "rationale", "violations", "evidence_refs"],
  "properties": {
    "score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Overall score (0.0-1.0, higher = better compliance)"
    },
    "label": {
      "type": "string",
      "enum": ["Pass", "Fail", "NeedsInfo", "Conditional"],
      "description": "Verdict label category"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "Human-readable rationale for the verdict"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "severity", "waivable", "description"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]+$",
            "description": "Rule identifier (e.g., 'CAWS-001')"
          },
          "severity": {
            "type": "string",
            "enum": ["Info", "Low", "Medium", "High", "Critical"],
            "description": "Severity level of the violation"
          },
          "waivable": {
            "type": "boolean",
            "description": "Whether this violation is waivable"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Human-readable description of the violation"
          }
        }
      },
      "description": "Specific violations found during evaluation"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "References to evidence supporting the verdict"
    }
  }
}
